# Copy this file to .env and adjust values if needed.
# docker-compose.yml has safe defaults for all variables,
# so you can run `docker compose up -d --build` without creating .env at all.

# PostgreSQL
POSTGRES_DB=team_exam_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT secret (change in production!)
JWT_KEY=change-me-in-production-use-a-long-random-string-at-least-64-chars

# ASP.NET environment: Production | Development
# Development enables Swagger UI at /swagger
ASPNETCORE_ENVIRONMENT=Production
