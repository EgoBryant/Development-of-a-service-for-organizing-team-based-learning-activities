                teamFlowState.checkInError = "╨Ч╨░╨┐╨╛╨╗╨╜╨╕╤В╨╡ ╤В╨╡╨║╤Б╤В ╨╛╤В╤З╨╡╤В╨░.";
                render();
                return;
            }

            void submitTeamCheckIn(week, report)
                .then(() => {
                    teamFlowState.checkInWeek = "";
