                        placeholder="╨Э╨Х╨Ф╨Х╨Ы╨п"
                        value="${escapeHtml(nextWeek)}"
                    >
                    <textarea
                        id="teamCheckInReportInput"
                        class="team-rescue-textarea"
                        placeholder="╨Ъ╤А╨░╤В╨║╨╛ ╨╛╨┐╨╕╤И╨╕╤В╨╡ ╨┐╤А╨╛╨│╤А╨╡╤Б╤Б, ╤А╨╕╤Б╨║╨╕ ╨╕ ╨┤╨╛╨│╨╛╨▓╨╛╤А╨╡╨╜╨╜╨╛╤Б╤В╨╕ ╨║╨╛╨╝╨░╨╜╨┤╤Л"
                        aria-label="╨Ю╤В╤З╨╡╤В ╨║╨╛╨╝╨░╨╜╨┤╤Л"
                    >${escapeHtml(teamFlowState.checkInReport)}</textarea>
                    <button type="submit" class="profile-team-flow-btn profile-team-flow-btn--search team-rescue-submit">╨Ю╨в╨Я╨а╨Р╨Т╨Ш╨в╨м</button>
