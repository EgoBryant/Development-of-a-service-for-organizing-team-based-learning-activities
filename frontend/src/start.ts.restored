        pointsValue = applicantRating ? String(applicantRating.points) : "тАФ";
        ratingValue =
            applicantRating && applicantRating.rank > 0 ? `${applicantRating.rank} ╨╝╨╡╤Б╤В╨╛` : "тАФ";
        avatarSrc = applicantRequest.avatarUrl?.trim() || "";
        achievementsContent = `
                    <div class="profile-achievements-empty" aria-live="polite">
                        <p class="profile-achievements-empty-text">╨Ф╨╛╤Б╤В╨╕╨╢╨╡╨╜╨╕╤П ╤Г╤З╨░╤Б╤В╨╜╨╕╨║╨░ ╨┐╨╛╤П╨▓╤П╤В╤Б╤П ╨╖╨┤╨╡╤Б╤М ╨┐╨╛╤Б╨╗╨╡ ╨▓╤Л╨┐╨╛╨╗╨╜╨╡╨╜╨╕╤П ╤З╨╡╨╗╨╗╨╡╨╜╨┤╨╢╨╡╨╣.</p>
                    </div>`;
    } else {
        const actualPoints = profile?.userPoints ?? profile?.teamScore ?? 0;
        pointsValue = String(actualPoints);
        ratingValue =
            profile?.personalRating && profile.personalRating > 0
                ? `${profile.personalRating} ╨╝╨╡╤Б╤В╨╛`
                : "тАФ";
        const rawLeagueValue = profile?.personalLeague?.trim() ?? "";
        leagueValue =
            rawLeagueValue && rawLeagueValue.toLowerCase() !== "╤Б╤В╨░╤А╤В" ? rawLeagueValue : "╨Э╨╛╨▓╨╕╤З╨╛╨║";
